{
  "name": "contaexpress",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/report-validation.test.mjs tests/report-calculations.test.mjs tests/report-pdf.test.mjs",
    "test:integration": "node --test tests/*.integration.test.mjs tests/password-reset.integration.test.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "test:all": "npm run test:unit && npm run test:integration",
    "backup:db": "bash scripts/db-backup.sh",
    "restore:db": "bash scripts/db-restore.sh",
    "verify:db-restore": "bash scripts/db-verify.sh"
  },
  "dependencies": {
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.1",
    "jose": "^5.9.6",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.6",
    "typescript": "^5.7.2",
    "@types/pg": "^8.11.10",
    "@types/bcryptjs": "^2.4.6"
  }
}
