# Local PostgreSQL credentials. Replace these values for your environment.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://contaexpress:change-me-local-only@localhost:5432/contaexpress

# Generate a unique random secret of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Password reset email delivery (Resend)
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
